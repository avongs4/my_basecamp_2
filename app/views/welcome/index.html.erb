<h1>Welcome to MyBasecamp2</h1>
<p>This is a project management tool to help teams collaborate.</p>

<% if user_signed_in? %>
  <p>Welcome, <%= current_user.name %>! <%= link_to "Go to Projects", projects_path %></p>
<% else %>
  <p><%= link_to "Sign Up", new_user_registration_path %> or <%= link_to "Log In", new_user_session_path %> to get started.</p>
<% end %>
